# E-kimina API — environment reference. Copy to .env and fill in. See docs/DEPLOYMENT.md.
# Required values are marked (required); everything else has a safe default.

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development                 # production in prod (turns on JSON logs, HSTS, Secure cookies)
PORT=4033
API_PREFIX=api
APP_NAME="E-kimina API"
APP_VERSION=                         # shown in /health and error reports
SWAGGER_ENABLED=true                 # /api/docs; set false in production if not needed
CORS_ORIGINS=http://localhost:3033   # comma-separated web app origins (cookies are credentialed)
FRONTEND_URL=http://localhost:3033   # links in emails
APP_URL=http://localhost:4033
TRUST_PROXY=                         # behind nginx/a load balancer: 1 (or loopback) so IPs are real

# ── Database (required) ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://ekimina:password@localhost:5432/ekimina?schema=public"

# ── Auth & sessions ─────────────────────────────────────────────────────────
JWT_SECRET=                          # (required) long random string; rotating it signs everyone out
ACCESS_TOKEN_TTL=15m                 # access tokens (refresh tokens renew them)
REFRESH_TOKEN_DAYS=30
BCRYPT_SALT_ROUNDS=10
COOKIE_SECURE=                       # true behind HTTPS (default: true when NODE_ENV=production)
COOKIE_SAMESITE=Lax                  # None only if the web app is on another site (needs HTTPS)
OTP_EXPIRATION_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=600            # per IP, all routes
RATE_LIMIT_DISABLED=false
PAYMENT_SECRETS_KEY=                 # encrypts group MoMo keys and VAPID key; set in production
HSTS=                                # true to send HSTS outside production

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=                           # empty = email off (codes then go by SMS only)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=E-kimina
APP_LOGO_URL=
NOTIFY_EMAIL_DRY_RUN=false           # staging: record notification emails without sending

# ── SMS ─────────────────────────────────────────────────────────────────────
SMS_PROVIDER=                        # mock | africastalking | http | disabled (default: mock outside production)
AT_USERNAME=                         # Africa's Talking (sandbox = test account)
AT_API_KEY=
AT_SENDER_ID=
SMS_HTTP_URL=                        # generic gateway: POST JSON {to, message, sender}
SMS_HTTP_TOKEN=
SMS_SENDER_ID=E-kimina
SMS_DAILY_LIMIT_PER_USER=20

# ── MTN MoMo ────────────────────────────────────────────────────────────────
MOMO_MODE=                           # mock | sandbox | production | disabled
MOMO_BASE_URL=
MOMO_TARGET_ENVIRONMENT=             # e.g. mtnrwanda
MOMO_CURRENCY=                       # EUR in sandbox, RWF in production
MOMO_CALLBACK_BASE_URL=              # public https URL of this API's /api
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_COLLECTION_USER_ID=
MOMO_COLLECTION_API_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_USER_ID=
MOMO_DISBURSEMENT_API_KEY=
MOMO_POLL_INTERVAL_SECONDS=60
MOMO_PENDING_TIMEOUT_MINUTES=30

# ── Uploads (Cloudinary) ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=e-kimina

# ── Web push ────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=                    # optional: generated once and stored if empty
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
PUSH_ALLOWED_HOSTS=                  # extra push service hosts (FCM/Mozilla/Windows/Apple are built in)
PUSH_ALLOW_INSECURE_ENDPOINTS=false  # tests only

# ── Background work ─────────────────────────────────────────────────────────
FINANCE_JOBS_ENABLED=true            # daily scheduler (late marking, fines, reminders, penalties)
FINANCE_DAILY_JOB_HOUR_UTC=3
JOBS_WORKER_ENABLED=true             # job queue worker (emails, SMS, MoMo checks); false on web-only nodes
JOBS_POLL_MS=1000
GROUPS_AUTO_VERIFY=false             # development: new groups start verified

# ── Observability ───────────────────────────────────────────────────────────
LOG_FORMAT=                          # json | pretty (default json in production)
LOG_LEVEL=log                        # verbose | debug | log | warn | error
ACCESS_LOG=true
SENTRY_DSN=                          # Sentry / GlitchTip DSN for error reports
